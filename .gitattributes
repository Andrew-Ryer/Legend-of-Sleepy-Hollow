# Normalize text to LF in the repository and working tree on every OS.
# Auto detection preserves binary assets, including binary .asset files.
* text=auto eol=lf

# Unity YAML and source files must use consistent text line endings.
*.cs text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.compute text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.meta text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.json text eol=lf
*.uxml text eol=lf
*.uss text eol=lf

# Windows command scripts require CRLF when checked out.
*.bat text eol=crlf
*.cmd text eol=crlf

# Keep common binary assets out of text conversion and text merges.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.tga binary
*.tif binary
*.tiff binary
*.psd binary
*.exr binary
*.hdr binary
*.ico binary
*.wav binary
*.mp3 binary
*.ogg binary
*.aif binary
*.aiff binary
*.mp4 binary
*.mov binary
*.fbx binary
*.blend binary
*.ttf binary
*.otf binary
*.dll binary
*.so binary
*.dylib binary
*.zip binary
*.unitypackage binary
